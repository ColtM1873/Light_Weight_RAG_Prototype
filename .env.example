# ===== LLM 配置模板 =====
# 复制为 .env 后填写自己的 key：
#   Copy-Item .env.example .env
#
# 只想跑离线 Mock 时可以不填 key：
#   python run.py demo --case normal

# provider：deepseek 或 openai
LLM_PROVIDER=deepseek
# 模型名：deepseek -> deepseek-chat / deepseek-reasoner；openai -> gpt-4o-mini 等
LLM_MODEL=deepseek-chat
# API key（不要提交到 git）
LLM_API_KEY=
# 可选：自定义接口地址（中转 / 代理）
# LLM_BASE_URL=
# 可选：覆盖 Model A 的系统提示
# AGENT_SYSTEM_PROMPT=

# 可选：工具故障注入（演示"工具失败"场景；不设置则关闭）
# RAG_FAULT_TOOL=query_the_docs
# RAG_FAULT_TIMES=1

# ===== 向量模型（首次 setup 自动下载）=====
# 国内网络默认使用 HuggingFace 镜像；网络允许时也可改成官方地址
HF_ENDPOINT=https://hf-mirror.com
# 只有完全离线、且本机已有模型缓存时才设为 1
# HF_HUB_OFFLINE=1
